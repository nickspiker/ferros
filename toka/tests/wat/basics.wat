(module
  (memory 1 16)
  (global $counter (mut i32) (i32.const 7))
  (global $k i64 (i64.const 0x1234_5678_9abc_def0))
  (global $vec (mut v128) (v128.const i32x4 1 2 3 4))
  (table 4 funcref)
  (elem (i32.const 0) $add $sub $mulf)
  (type $bin (func (param i32 i32) (result i32)))
  (data (i32.const 64) "hello, ferros")
  (func $add (type $bin) (i32.add (local.get 0) (local.get 1)))
  (func $sub (type $bin) (i32.sub (local.get 0) (local.get 1)))
  (func $mulf (param f64 f64) (result f64) (f64.mul (f64.mul (local.get 0) (local.get 1)) (f64.const 3.14159265358979)))
  (func (export "loads") (param $p i32) (result i64)
    (i64.add
      (i64.add (i64.load offset=8 (local.get $p)) (i64.load32_u offset=4096 (local.get $p)))
      (i64.add (i64.extend_i32_u (i32.load8_s offset=100000 (local.get $p))) (i64.load offset=0x90000000 (local.get $p)))))
  (func (export "stores") (param $p i32) (param $v i64)
    (i64.store offset=16 (local.get $p) (local.get $v))
    (i32.store16 (local.get $p) (i32.wrap_i64 (local.get $v)))
    (f32.store offset=3 (local.get $p) (f32.const 1.5))
    (v128.store offset=32 (local.get $p) (global.get $vec)))
  (func (export "globals") (result i64)
    (global.set $counter (i32.add (global.get $counter) (i32.const 1)))
    (i64.add (i64.extend_i32_s (global.get $counter)) (global.get $k)))
  (func (export "indirect") (param i32 i32 i32) (result i32)
    (call_indirect (type $bin) (local.get 1) (local.get 2) (local.get 0)))
  (func (export "switch") (param i32) (result i32)
    (block $d (block $c (block $b (block $a
      (br_table $a $b $c $d (local.get 0)))
      (return (i32.const 10)))
      (return (i32.const 20)))
      (return (i32.const 30)))
    (i32.const 40))
  (func (export "sum") (param $n i32) (result i64) (local $i i32) (local $s i64)
    (block $out (loop $l
      (br_if $out (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $s (i64.add (local.get $s) (i64.load (i32.shl (local.get $i) (i32.const 3)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (local.get $s))
  (func (export "bulk") (param $d i32) (param $s i32) (param $n i32)
    (memory.copy (local.get $d) (local.get $s) (local.get $n))
    (memory.fill (local.get $d) (i32.const 0xAA) (local.get $n)))
  (func (export "grow") (param i32) (result i32) (drop (memory.grow (local.get 0))) (memory.size))
  (func (export "simd") (param $p i32) (result v128)
    (i32x4.add (v128.load (local.get $p)) (i8x16.shuffle 0 1 2 3 16 17 18 19 4 5 6 7 20 21 22 23 (v128.load offset=16 (local.get $p)) (v128.const i64x2 0x0102030405060708 0x1112131415161718))))
  (func (export "atomics") (param $p i32) (result i64)
    (drop (i32.atomic.rmw.add (local.get $p) (i32.const 1)))
    (drop (i64.atomic.rmw.cmpxchg offset=8 (local.get $p) (i64.const 0) (i64.const 5)))
    (i64.atomic.rmw8.xchg_u offset=16 (local.get $p) (i64.const 3)))
  (func $fact (param i64 i64) (result i64)
    (if (result i64) (i64.eqz (local.get 0)) (then (local.get 1))
      (else (return_call $fact (i64.sub (local.get 0) (i64.const 1)) (i64.mul (local.get 0) (local.get 1))))))
  (func (export "fact") (param i64) (result i64) (call $fact (local.get 0) (i64.const 1)))
  (func (export "div") (param i64 i64) (result i64) (i64.div_s (local.get 0) (local.get 1)))
  (func (export "deep") (param f64) (result f64)
    (local f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64)
    (local.set 1 (f64.add (local.get 0) (f64.const 1.1)))
    (local.set 2 (call $mulf (local.get 1) (local.get 0)))
    (f64.add (local.get 2) (local.get 1)))
)
